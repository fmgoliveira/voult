{
  "expo": {
    "name": "Voult",
    "slug": "voult",
    "scheme": "voult",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.franciscoliveira.voult",
      "minSdkVersion": 26,
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC"],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/foreground.png",
        "monochromeImage": "./assets/branding/monochrome.png",
        "backgroundColor": "#2563EB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Voult uses the camera only to scan 2FA QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash.png",
          "imageWidth": 220,
          "backgroundColor": "#f4f7fd",
          "dark": {
            "image": "./assets/branding/splash.png",
            "backgroundColor": "#0b1220"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/branding/icon.png"
  }
}
