{
  "expo": {
    "name": "Voult",
    "slug": "voult",
    "scheme": "voult",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.franciscoliveira.voult",
      "minSdkVersion": 26,
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC"],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Voult uses the camera only to scan 2FA QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
