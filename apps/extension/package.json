{
  "name": "@voult/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@voult/core": "workspace:*",
    "@voult/ui-tokens": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wxt": "^0.21.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2"
  }
}
