{
  "name": "@voult/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "e2e": "cross-env WXT_E2E=1 wxt build && playwright test"
  },
  "dependencies": {
    "@voult/core": "workspace:*",
    "@voult/ui-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.64.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "wxt": "^0.21.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  }
}
