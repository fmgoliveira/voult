# Copy to .env next to docker-compose.yml. Never commit .env.
PORT=8787
DATA_DIR=/data
# Required: at least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Signup closes after the first account unless this is true.
MULTI_USER=false
# Set to true only when a reverse proxy sets X-Forwarded-For (used for login rate limiting).
TRUST_PROXY=true

# --- Google Drive backups (optional) -------------------------------------------------------
# Create an OAuth client of type "Web application" in Google Cloud Console, enable the Google
# Drive API, add this redirect URI:  <PUBLIC_URL>/backup/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The https URL your clients use to reach this server.
# PUBLIC_URL=https://voult.example.com
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION=30
