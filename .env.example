# Copy to .env on the VM. Never commit .env.
PORT=8787
DATA_DIR=/data
# Required: at least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Signup closes after the first account unless this is true.
MULTI_USER=false
# Behind Caddy: trust X-Forwarded-For for rate limiting.
TRUST_PROXY=true
